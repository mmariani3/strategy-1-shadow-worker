  ],
  "constraints": [
    {
      "name": "strategy_signals_decision_check",
      "table": "strategy_signals",
      "definition": "CHECK ((decision = ANY (ARRAY['TRADE'::text, 'WAIT'::text, 'NO_TRADE'::text])))"
    },
    {
      "name": "strategy_signals_direction_check",
      "table": "strategy_signals",
      "definition": "CHECK ((direction = ANY (ARRAY['LONG'::text, 'SHORT'::text])))"
    },
    {
      "name": "strategy_signals_experiment_class_check",
      "table": "strategy_signals",
      "definition": "CHECK ((experiment_class = ANY (ARRAY['STRATEGY_1'::text, 'INFRASTRUCTURE_TEST'::text])))"
    },
    {
      "name": "strategy_signals_nonnegative_prices",
      "table": "strategy_signals",
      "definition": "CHECK ((((entry_price IS NULL) OR (entry_price > (0)::numeric)) AND ((stop_price IS NULL) OR (stop_price > (0)::numeric)) AND ((target_price IS NULL) OR (target_price > (0)::numeric)) AND ((risk_per_share IS NULL) OR (risk_per_share >= (0)::numeric)) AND ((dollar_risk IS NULL) OR (dollar_risk >= (0)::numeric)) AND ((notional IS NULL) OR (notional >= (0)::numeric))))"
    },
    {
      "name": "strategy_signals_pkey",
      "table": "strategy_signals",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "strategy_signals_positive_qty",
      "table": "strategy_signals",
      "definition": "CHECK (((qty IS NULL) OR (qty > 0)))"
    },
    {
      "name": "strategy_signals_shadow_no_execution",
      "table": "strategy_signals",
      "definition": "CHECK (((status <> 'SHADOW'::text) OR ((alpaca_order_id IS NULL) AND (executor_response IS NULL) AND (execution_status IS NULL))))"
    },
    {
      "name": "strategy_signals_status_check",
      "table": "strategy_signals",
      "definition": "CHECK ((status = ANY (ARRAY['SHADOW'::text, 'PENDING'::text, 'SUBMITTED'::text, 'FILLED'::text, 'CANCELLED'::text, 'REJECTED'::text, 'ERROR'::text])))"
    },
    {
      "name": "strategy_signals_strategy_id_check",
      "table": "strategy_signals",
      "definition": "CHECK ((strategy_id = 'STRATEGY_1'::text))"
    },
    {
      "name": "strategy_candidates_catalyst_tier_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((catalyst_tier = ANY (ARRAY['A'::text, 'B'::text, 'C'::text])))"
    },
    {
      "name": "strategy_candidates_direction_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((direction = ANY (ARRAY['LONG'::text, 'SHORT'::text])))"
    },
    {
      "name": "strategy_candidates_discovery_phase_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((discovery_phase = ANY (ARRAY['PREMARKET'::text, 'POST_OPEN'::text])))"
    },
    {
      "name": "strategy_candidates_experiment_class_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((experiment_class = ANY (ARRAY['STRATEGY_1'::text, 'INFRASTRUCTURE_TEST'::text])))"
    },
    {
      "name": "strategy_candidates_journal_trade_id_key",
      "table": "strategy_candidates",
      "definition": "UNIQUE (journal_trade_id)"
    },
    {
      "name": "strategy_candidates_last_signal_id_fkey",
      "table": "strategy_candidates",
      "definition": "FOREIGN KEY (last_signal_id) REFERENCES strategy_signals(id)"
    },
    {
      "name": "strategy_candidates_last_worker_decision_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((last_worker_decision = ANY (ARRAY['TRADE'::text, 'WAIT'::text, 'NO_TRADE'::text])))"
    },
    {
      "name": "strategy_candidates_market_regime_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((market_regime = ANY (ARRAY['Bullish'::text, 'Bearish'::text, 'Mixed'::text, 'Choppy'::text])))"
    },
    {
      "name": "strategy_candidates_operational_state_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((operational_state = ANY (ARRAY['HOLD_UNRESOLVED'::text, 'WAITING_FOR_TRIGGER'::text, 'CONFIRMATION_REQUIRED'::text, 'TRADE_READY'::text, 'REJECTED'::text])))"
    },
    {
      "name": "strategy_candidates_pkey",
      "table": "strategy_candidates",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "strategy_candidates_status_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((status = ANY (ARRAY['WAITING'::text, 'TRIGGER_OBSERVED'::text, 'CONFIRMATION_REQUIRED'::text, 'SHADOW_TRADE'::text, 'NO_TRADE'::text, 'CLOSED'::text])))"
    },
    {
      "name": "strategy_candidates_trigger_operator_check",
      "table": "strategy_candidates",
      "definition": "CHECK ((trigger_operator = ANY (ARRAY['GTE'::text, 'LTE'::text])))"
    },
    {
      "name": "strategy_candidates_trigger_pair",
      "table": "strategy_candidates",
      "definition": "CHECK ((((trigger_price IS NULL) AND (trigger_operator IS NULL)) OR ((trigger_price IS NOT NULL) AND (trigger_operator IS NOT NULL))))"
    },
    {
      "name": "strategy_candidate_events_candidate_id_fkey",
      "table": "strategy_candidate_events",
      "definition": "FOREIGN KEY (candidate_id) REFERENCES strategy_candidates(id) ON DELETE CASCADE"
    },
    {
      "name": "strategy_candidate_events_event_type_check",
      "table": "strategy_candidate_events",
      "definition": "CHECK ((event_type = ANY (ARRAY['INGESTED'::text, 'UPDATED'::text, 'PRICE_CHECK'::text, 'TRIGGER_OBSERVED'::text, 'TRIGGER_CONFIRMED'::text, 'WORKER_EVALUATED'::text, 'CLOSED'::text, 'ERROR'::text])))"
    },
    {
      "name": "strategy_candidate_events_pkey",
      "table": "strategy_candidate_events",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "strategy_discovery_runs_phase_check",
      "table": "strategy_discovery_runs",
      "definition": "CHECK ((phase = ANY (ARRAY['PREMARKET'::text, 'POST_OPEN'::text])))"
    },
    {
      "name": "strategy_discovery_runs_pkey",
      "table": "strategy_discovery_runs",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "strategy_discovery_runs_status_check",
      "table": "strategy_discovery_runs",
      "definition": "CHECK ((status = ANY (ARRAY['IN_PROGRESS'::text, 'PARTIAL'::text, 'COMPLETE'::text, 'DATA_UNAVAILABLE'::text, 'ERROR'::text])))"
    },
    {
      "name": "strategy_discovery_items_operational_state_check",
      "table": "strategy_discovery_items",
      "definition": "CHECK ((operational_state = ANY (ARRAY['WATCHLIST_CANDIDATE'::text, 'WORKER_READY'::text])))"
    },
    {
      "name": "strategy_discovery_items_pkey",
      "table": "strategy_discovery_items",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "strategy_discovery_items_promotion_status_check",
      "table": "strategy_discovery_items",
      "definition": "CHECK ((promotion_status = ANY (ARRAY['DISCOVERED'::text, 'REVIEW_REQUIRED'::text, 'ELIGIBLE_FOR_ORCHESTRATOR'::text, 'PROMOTED'::text, 'REJECTED'::text])))"
    },
    {
      "name": "strategy_discovery_items_run_id_fkey",
      "table": "strategy_discovery_items",
      "definition": "FOREIGN KEY (run_id) REFERENCES strategy_discovery_runs(id) ON DELETE CASCADE"
    },
    {
      "name": "strategy_discovery_items_run_id_symbol_key",
      "table": "strategy_discovery_items",
      "definition": "UNIQUE (run_id, symbol)"
    },
    {
      "name": "strategy_discovery_items_verification_status_check",
      "table": "strategy_discovery_items",
      "definition": "CHECK ((verification_status = ANY (ARRAY['REVIEW_REQUIRED'::text, 'EVIDENCE_PRESENT'::text, 'VERIFIED'::text, 'REJECTED'::text])))"
    }
  ]
}
